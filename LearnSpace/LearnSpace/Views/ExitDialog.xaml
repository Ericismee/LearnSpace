<Window x:Class="LearnSpace.Views.ExitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thoát Ứng Dụng" Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
        
    <Border Background="White" CornerRadius="12" Margin="16" Padding="32" 
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="4" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="⚠️ THOÁT ỨNG DỤNG" FontSize="20" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center" Margin="0,0,0,12"/>
            <TextBlock Text="Vui lòng nhập mã thoát 6 số (Lấy từ phần mềm Quản lý)." 
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#6B7280" Margin="0,0,0,24"/>
            
            <TextBox x:Name="TxtExitCode" FontSize="28" FontWeight="Bold" HorizontalContentAlignment="Center" 
                     MaxLength="6" Margin="0,0,0,24" Padding="12" 
                     Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1"/>
                     
            <Button Content="Xác Nhận Thoát" Click="BtnConfirm_Click" 
                    Background="#EF4444" Foreground="White" FontSize="16" FontWeight="SemiBold" 
                    Padding="0,12" BorderThickness="0" Cursor="Hand">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>
            
            <Button Content="Hủy bỏ" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Foreground="#6B7280" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
    </Border>
</Window>
