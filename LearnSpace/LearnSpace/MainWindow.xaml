<Window x:Class="LearnSpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:LearnSpace.ViewModels"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="LearnSpace - Kết nối" Height="500" Width="500"
        WindowStartupLocation="CenterScreen"
        Icon="logo.png">

    <Window.DataContext>
        <viewmodels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="MyNotifyIcon"
                        ToolTipText="LearnSpace - Đang chạy ngầm"
                        MenuActivation="RightClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Thông tin" />
                    <Separator />
                    <MenuItem Header="Mở giao diện (Dev Mode)" Click="MenuOpenUI_Click" />
                    <MenuItem Header="Thoát hoàn toàn (Dev Mode)" Click="MenuExit_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F0F4F8" Offset="0"/>
                    <GradientStop Color="#E2E8F0" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <Border Background="White" CornerRadius="16" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Padding="32" BorderBrush="#E5E7EB" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="24" ShadowDepth="8" />
                </Border.Effect>
                <StackPanel>
                    <!-- Logo -->
                    <Image Source="logo.png" Width="80" Height="80" Margin="0,0,0,16" RenderOptions.BitmapScalingMode="HighQuality"/>
                    
                    <TextBlock Text="KẾT NỐI THIẾT BỊ" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="#1E293B"
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,8" />

                    <TextBlock Text="{Binding StatusMessage}" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               Foreground="#64748B" 
                               Margin="0,0,0,24" />

                    <!-- Nhập PIN -->
                    <TextBox Text="{Binding PinInput, UpdateSourceTrigger=PropertyChanged}" 
                             FontSize="36" 
                             FontWeight="Bold"
                             Foreground="#0F172A"
                             Background="#F8FAFC"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Padding="8"
                             HorizontalContentAlignment="Center" 
                             MaxLength="6" 
                             Margin="0,0,0,24" />

                    <!-- Nút bấm -->
                    <Button Content="Kết Nối" 
                            Command="{Binding ConnectCommand}" 
                            Background="#3B82F6" Foreground="White" FontSize="16" FontWeight="SemiBold" 
                            Padding="0,14" BorderThickness="0" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
