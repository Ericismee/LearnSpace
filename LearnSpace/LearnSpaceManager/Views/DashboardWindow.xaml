<Window x:Class="LearnSpaceManager.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LearnSpaceManager.Converters"
        Title="LearnSpace - Bảng điều khiển Quản trị" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F8FAFC"
        FontFamily="Segoe UI"
        Icon="/logo.png">
    
    <Window.Resources>
        <converters:Base64ImageConverter x:Key="Base64ImageConverter"/>
        <converters:IndexToVisibilityConverter x:Key="IndexToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets, Segoe UI Symbol</FontFamily>

        <!-- Toggle Switch CheckBox Style -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="40" Height="22" CornerRadius="11" Background="#CBD5E1" VerticalAlignment="Center">
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9" Background="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.2" BlurRadius="3" ShadowDepth="1" />
                                    </Border.Effect>
                                </Border>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#3B82F6" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar RadioButton Style -->
        <Style x:Key="SidebarItemStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}" Margin="{TemplateBinding Margin}" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Standard Button Style -->
        <Style TargetType="Button" x:Key="StandardBtn">
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Expanded Text Style -->
        <Style x:Key="ExpandedText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Visible"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleSidebarBtn}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Card Style -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="12" ShadowDepth="2" Direction="270" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="White" Padding="0,24,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="260"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=ToggleSidebarBtn}" Value="True">
                            <Setter Property="Width" Value="80"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            
            <StackPanel>
                <ToggleButton x:Name="ToggleSidebarBtn" Width="36" Height="36" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" Margin="0,0,16,16">
                    <ToggleButton.Content>
                        <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="16" Foreground="#64748B" />
                    </ToggleButton.Content>
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" Margin="24,0,24,32" VerticalAlignment="Center">
                    <Image Source="/logo.png" Width="36" Height="36" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="LearnSpace" FontSize="22" FontWeight="Black" Foreground="#0F172A" VerticalAlignment="Center" Style="{StaticResource ExpandedText}"/>
                </StackPanel>
                
                <StackPanel Margin="16,0">
                    <RadioButton GroupName="Menu" IsChecked="True" Style="{StaticResource SidebarItemStyle}" Command="{Binding SwitchTabCommand}" CommandParameter="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Màn Hình Trực Tiếp" Style="{StaticResource ExpandedText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Menu" Style="{StaticResource SidebarItemStyle}" Command="{Binding SwitchTabCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Lịch Sử Phím Gõ" Style="{StaticResource ExpandedText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Menu" Style="{StaticResource SidebarItemStyle}" Command="{Binding SwitchTabCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Quản Lý Ứng Dụng" Style="{StaticResource ExpandedText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Menu" Style="{StaticResource SidebarItemStyle}" Command="{Binding SwitchTabCommand}" CommandParameter="3">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Điều Khiển Từ Xa" Style="{StaticResource ExpandedText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    
                    <RadioButton GroupName="Menu" Style="{StaticResource SidebarItemStyle}" Command="{Binding SwitchTabCommand}" CommandParameter="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" Width="32" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Text="Cấu Hình Bảo Mật" Style="{StaticResource ExpandedText}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Border Padding="40" MaxWidth="1200" HorizontalAlignment="Stretch">
                <Grid>
                    <!-- NỘI DUNG TAB 0: LIVE SCREEN -->
                    <Grid Visibility="{Binding CurrentTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=0}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <!-- HEADER -->
                            <Grid Margin="0,0,0,32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Màn Hình Trực Tiếp" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="Theo dõi màn hình thời gian thực của máy trạm" FontSize="15" Foreground="#64748B" Margin="0,8,0,0"/>
                                </StackPanel>
                                
                                <!-- UNIFIED SECURITY BADGE -->
                                <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="8,4" VerticalAlignment="Center" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.04" BlurRadius="12" ShadowDepth="4" />
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <!-- Thoát -->
                                        <StackPanel Margin="16,8,20,8">
                                            <TextBlock Text="MÃ DEV / THOÁT" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding ExitCode}" FontSize="24" FontWeight="Black" Foreground="#EF4444" FontFamily="Consolas"/>
                                        </StackPanel>
                                        
                                        <!-- Divider -->
                                        <Rectangle Width="1" Fill="#F1F5F9" Margin="0,8,0,8"/>

                                        <!-- Unlock -->
                                        <StackPanel Margin="20,8,16,8">
                                            <TextBlock Text="KIOSK UNLOCK" Foreground="#64748B" FontSize="10" FontWeight="Bold" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding UnlockCode}" FontSize="24" FontWeight="Black" Foreground="#10B981" FontFamily="Consolas"/>
                                        </StackPanel>
                                        
                                        <!-- Divider -->
                                        <Rectangle Width="1" Fill="#F1F5F9" Margin="0,8,0,8"/>

                                        <!-- Refresh Button -->
                                        <Button Command="{Binding RefreshSecurityCodesCommand}" 
                                                ToolTip="Làm mới bộ mã bảo mật" 
                                                Background="Transparent" BorderThickness="0" 
                                                Foreground="#94A3B8" Padding="16,0" Cursor="Hand" Margin="4,0,0,0">
                                            <Button.Resources>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#F8FAFC"/>
                                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                                        <Setter Property="Foreground" Value="#2563EB"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Resources>
                                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="18" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- CONTENT ROW -->
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#3B82F6"/>
                                        <TextBlock Text="Màn hình Kiosk" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Row="1" Background="#0F172A" CornerRadius="8" ClipToBounds="True" MinHeight="500">
                                        <Grid>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="&#xE81E;" FontFamily="{StaticResource IconFont}" FontSize="40" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                                <TextBlock Text="Đang chờ luồng tín hiệu..." HorizontalAlignment="Center" Foreground="#94A3B8" FontSize="15"/>
                                            </StackPanel>
                                            <Image Source="{Binding LiveScreenUrl}" Stretch="Uniform" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                    
                    <!-- NỘI DUNG TAB 1: KEYLOGGER -->
                    <Grid Visibility="{Binding CurrentTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=1}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Lịch Sử Phím Gõ" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Báo cáo toàn bộ phím tắt và văn bản đã gõ trên máy trạm" FontSize="15" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <!-- CONTENT ROW -->
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="20" Foreground="#3B82F6"/>
                                        <TextBlock Text="Báo Cáo Keylogger (Đã làm sạch)" FontSize="18" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    </StackPanel>
                                    
                                    <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12" MinHeight="500">
                                        <TextBox IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" 
                                                 Text="{Binding RecentKeylogs}" Background="Transparent" BorderThickness="0" 
                                                 Foreground="#334155" FontSize="16" FontFamily="Consolas" Padding="12"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- NỘI DUNG TAB 2: QUẢN LÝ ỨNG DỤNG -->
                    <Grid Visibility="{Binding CurrentTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=2}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Quản Lý Ứng Dụng" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Cấp quyền hiển thị các phần mềm trên Menu CyberCafe của máy khách" FontSize="15" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="-8">
                                    <ItemsControl ItemsSource="{Binding InstalledApps}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="1" BorderBrush="#E2E8F0" CornerRadius="12" Width="180" Height="220" Margin="12" Background="#F8FAFC">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                                        <Border Background="White" CornerRadius="12" Width="72" Height="72" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                                                            <Image Source="{Binding IconBase64, Converter={StaticResource Base64ImageConverter}}" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Bold" FontSize="14" Foreground="#0F172A" Margin="0,0,0,16" Height="38"/>
                                                        <CheckBox Content="Cấp Phép" IsChecked="{Binding IsAllowed}" 
                                                                  Command="{Binding DataContext.ToggleAppAllowedCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                                  CommandParameter="{Binding}"
                                                                  Style="{StaticResource ToggleSwitchStyle}"
                                                                  HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- NỘI DUNG TAB 3: ĐIỀU KHIỂN TỪ XA -->
                    <Grid Visibility="{Binding CurrentTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=3}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Điều Khiển Từ Xa" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Gửi lệnh điều khiển trạng thái nguồn và màn hình" FontSize="15" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                                <StackPanel HorizontalAlignment="Left" Width="400">
                                    <TextBlock Text="Các Lệnh Khẩn Cấp" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,24"/>
                                    
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#3B82F6" Margin="0,0,0,24" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    
                                    <!-- Khởi Động Kiosk -->
                                    <Button Style="{StaticResource StandardBtn}" Command="{Binding LockStudyModeCommand}" Background="#EFF6FF" Foreground="#1D4ED8" Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/>
                                            <TextBlock Text="Khởi Động Kiosk Mode" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                            
                                    <!-- Khóa Đen -->
                                    <Button Style="{StaticResource StandardBtn}" Command="{Binding LockScreenCommand}" Background="#FEF2F2" Foreground="#B91C1C" Margin="0,0,0,32">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/>
                                            <TextBlock Text="Khóa Đen Khẩn Cấp" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    
                                    <!-- Mở Khóa Toàn Bộ -->
                                    <Button Style="{StaticResource StandardBtn}" Command="{Binding UnlockCommand}" Background="#10B981" Foreground="White">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE785;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,12,0"/>
                                            <TextBlock Text="Mở Khóa Toàn Bộ (Unlock)" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- NỘI DUNG TAB 4: CẤU HÌNH BẢO MẬT -->
                    <Grid Visibility="{Binding CurrentTabIndex, Converter={StaticResource IndexToVisibilityConverter}, ConverterParameter=4}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Margin="0,0,0,32">
                                <TextBlock Text="Cấu Hình Bảo Mật" FontSize="32" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text="Tùy chỉnh danh sách đen phần mềm và quy tắc máy khách" FontSize="15" Foreground="#64748B" Margin="0,8,0,0"/>
                            </StackPanel>
                            
                            <Border Grid.Row="1" Style="{StaticResource CardStyle}" VerticalAlignment="Top">
                                <StackPanel HorizontalAlignment="Left" Width="500">
                                    <TextBlock Text="Khóa Ứng Dụng Cụ Thể (Blacklist)" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,24"/>
                                    
                                    <TextBlock Text="Nhập tên tiến trình (vd: LolClient.exe, msedge.exe) để cấm khởi chạy. Máy khách sẽ tự động văng (kill process) khi phần mềm này được mở:" Foreground="#475569" Margin="0,0,0,16" FontSize="14" TextWrapping="Wrap"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtAppToBlock" Text="LolClient.exe" Margin="0,0,16,0" Padding="16,12" FontSize="14" Foreground="#0F172A" FontWeight="SemiBold" BorderBrush="#CBD5E1" BorderThickness="1" Background="White" VerticalContentAlignment="Center">
                                            <TextBox.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></TextBox.Resources>
                                        </TextBox>
                                        <Button Grid.Column="1" Style="{StaticResource StandardBtn}" Command="{Binding LockSpecificAppCommand}" 
                                                CommandParameter="{Binding Text, ElementName=TxtAppToBlock}"
                                                Background="#3B82F6" Foreground="White" Padding="24,12">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE71A;" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Áp Dụng Khóa" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    
                                    <TextBlock Text="{Binding StatusMessage}" Foreground="#3B82F6" Margin="0,24,0,0" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
